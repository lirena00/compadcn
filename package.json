{
  "name": "shadcn-plus",
  "version": "2.0.0",
  "description": "Inventory, audit, and safely manage components across shadcn registries",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "shadcn-plus": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "docs/compatibility.md",
    "skills/shadcn-plus/SKILL.md",
    "examples/ci/*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "dev:watch": "tsx watch src/cli.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepack": "pnpm run clean && pnpm run build",
    "link-cli": "pnpm run build && pnpm unlink --global && pnpm link --global",
    "test": "pnpm run build && node --test",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:frameworks": "pnpm run build && node scripts/verify-frameworks.mjs",
    "benchmark": "pnpm run build && node scripts/benchmark.mjs"
  },
  "keywords": [
    "cli",
    "shadcn",
    "ui",
    "components",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lirena00/compadcn.git"
  },
  "homepage": "https://github.com/lirena00/compadcn#readme",
  "bugs": {
    "url": "https://github.com/lirena00/compadcn/issues"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.3"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "diff": "9.0.0",
    "execa": "^9.6.0",
    "get-tsconfig": "^4.14.3",
    "jsonc-parser": "^3.3.1",
    "knip": "6.45.0",
    "parse5": "8.0.0",
    "shadcn": "4.23.0",
    "tinyglobby": "^0.2.17",
    "typescript": "5.8.3",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  }
}
